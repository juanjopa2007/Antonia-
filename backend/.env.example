# Copia este fichero a .env para desarrollo local. NUNCA lo subas a git con valores reales.

# Clave de la consola de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Tokens que la app usará para identificarse (mínimo 24 caracteres, separa varios con comas).
# Genera uno con: openssl rand -hex 32
APP_TOKENS=

# Opcional: clave de Brave Search API. Sin ella, la búsqueda en Internet queda desactivada.
BRAVE_API_KEY=

# Opcionales
MODEL=claude-sonnet-5-5
MAX_TOKENS=1024
MAX_TOOL_ITERATIONS=8
RATE_LIMIT_PER_MINUTE=30
PORT=8080
